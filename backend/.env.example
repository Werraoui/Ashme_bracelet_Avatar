DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Auth (JWT)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Alerts: email (SMTP) — primary notification channel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your.email@gmail.com
SMTP_TLS=true

# Optional: skip real sends during tests
NOTIF_DRY_RUN=false

# Optional fallback: SMS (Twilio) if contact has no email but SMS env is set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
